{
	"info": {
		"_postman_id": "flipplay-modul4-rest-api",
		"name": "FlipPlay REST API - Modul 4",
		"description": "Koleksi Postman lengkap untuk Demo Modul 4 (Happy Path & Failure Path)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Happy Path - Media CRUD",
			"item": [
				{
					"name": "GET All Media (Pagination)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "http://127.0.0.1:8000/api/media",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "media"]
						}
					}
				},
				{
					"name": "GET Search Media by Title (?search=Grand)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "http://127.0.0.1:8000/api/media?search=Grand",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "media"],
							"query": [
								{ "key": "search", "value": "Grand" }
							]
						}
					}
				},
				{
					"name": "GET Detail 1 Media + Users",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "http://127.0.0.1:8000/api/media/1",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "media", "1"]
						}
					}
				},
				{
					"name": "POST Create New Media (201 Created)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Solo Leveling\",\n  \"type\": \"Anime\",\n  \"genre\": \"Action / Fantasy\",\n  \"rating\": 8.7,\n  \"release_year\": 2024,\n  \"total_count\": 12,\n  \"creator\": \"A-1 Pictures\"\n}"
						},
						"url": {
							"raw": "http://127.0.0.1:8000/api/media",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "media"]
						}
					}
				},
				{
					"name": "PATCH Update Media (200 OK)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rating\": 9.1\n}"
						},
						"url": {
							"raw": "http://127.0.0.1:8000/api/media/6",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "media", "6"]
						}
					}
				},
				{
					"name": "DELETE Media (200 OK)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "http://127.0.0.1:8000/api/media/6",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "media", "6"]
						}
					}
