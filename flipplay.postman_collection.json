						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Grand Blue Dreaming\",\n  \"type\": \"Anime\",\n  \"genre\": \"Comedy / Slice of Life\",\n  \"rating\": 8.4,\n  \"release_year\": 2018,\n  \"total_count\": 12,\n  \"creator\": \"Zero-G\"\n}"
						},
