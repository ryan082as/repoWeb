							"mode": "raw",
							"raw": "{\n  \"title\": \"\",\n  \"type\": \"Novel\",\n  \"genre\": \"\",\n  \"rating\": 15\n}"
						},
						"url": {
							"raw": "http://127.0.0.1:8000/api/media",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "media"]
						}
					}
				},
				{
