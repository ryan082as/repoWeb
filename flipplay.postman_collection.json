					"name": "POST Attach Media to User Collection",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"media_id\": 3\n}"
						},
						"url": {
							"raw": "http://127.0.0.1:8000/api/users/1/collection",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "users", "1", "collection"]
						}
					}
				},
				{
					"name": "DELETE Detach Media from User Collection",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "http://127.0.0.1:8000/api/users/1/collection/3",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "users", "1", "collection", "3"]
						}
					}
				}
			]
		},
		{
