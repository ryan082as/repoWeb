						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"media_id\": 1\n}"
						},
						"url": {
							"raw": "http://127.0.0.1:8000/api/users/1/collection",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["api", "users", "1", "collection"]
						}
					}
				},
				{
					"name": "GET Non-existent Media ID (404 Not Found)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
